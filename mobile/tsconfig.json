{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src",
    "App.tsx",
    "app.json"
  ],
  "exclude": [
    "node_modules",
    "src/__tests__"
  ]
}
