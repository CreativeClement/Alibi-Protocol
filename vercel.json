{
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/alibi-protocol-app",
      "destination": "/app.html"
    },
    {
      "source": "/api/legal-guidance",
      "destination": "https://alibi-api.timrclement.workers.dev/legal-guidance"
    },
    {
      "source": "/api/founding-shield",
      "destination": "https://alibi-api.timrclement.workers.dev/founding-shield"
    },
    {
      "source": "/api/founding-shield/:path*",
      "destination": "https://alibi-api.timrclement.workers.dev/founding-shield/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self)" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
